                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('superadmin_token', json.token || json.accessToken || '');",
                  "console.log('✅ SUPER_ADMIN token saved:', pm.collectionVariables.get('superadmin_token').substring(0,30) + '...');"
                ],
