# Copy to .env.production on the deployment host. Never commit the real file.
BACKEND_IMAGE=ghcr.io/your-github-user/your-repository/backend:v1.0.0
FRONTEND_IMAGE=ghcr.io/your-github-user/your-repository/frontend:v1.0.0

DB_PASSWORD=Replace_With_A_Strong_SQL_Server_Password_2026!
JWT_SECRET=Replace_With_A_Random_Secret_Of_At_Least_32_Characters
# Use update only for the first deployment to initialize an empty database.
# Change this to validate after the first successful startup.
JPA_DDL_AUTO=update

FRONTEND_URL=https://erp.example.com
CORS_ALLOWED_ORIGINS=https://erp.example.com
API_URL=https://api.example.com

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Replace_With_A_Strong_Admin_Password

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

FINANCE_OVERDUE_SCAN_ENABLED=true
FINANCE_OVERDUE_SCAN_CRON=0 15 6 * * *
FINANCE_OVERDUE_SCAN_ZONE=Africa/Tunis
