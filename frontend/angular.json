{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "template": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/template",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/assets/icons/fontawesome/css/fontawesome.min.css",
              "src/assets/icons/fontawesome/css/all.min.css",
              "node_modules/ngx-bootstrap/datepicker/bs-datepicker.css",
              "node_modules/primeicons/primeicons.css",
              "node_modules/primeng/resources/themes/lara-light-blue/theme.css",
              "node_modules/primeng/resources/primeng.min.css",
              "node_modules/bootstrap/scss/bootstrap.scss",
              "src/assets/css/animate.css",
              "src/assets/icons/ionic/ionicons.css",
              "src/assets/icons/material/materialdesignicons.css",
              "src/assets/icons/pe7/pe-icon-7.css",
              "src/assets/icons/themify/themify.css",
              "src/assets/icons/typicons/typicons.css",
              "src/assets/icons/weather/weathericons.css",
              "src/assets/icons/flags/flags.css",
              "src/assets/icons/simpleline/simple-line-icons.css",
              "src/assets/icons/feather/css/iconfont.css",
              "src/assets/icons/boxicons/css/boxicons.min.css",
              "./node_modules/ngx-lightbox/lightbox.css",
              "node_modules/plyr/dist/plyr.css",
              "src/styles.scss"
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js",
              "node_modules/plyr/dist/plyr.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "6mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "5mb",
                  "maximumError": "5mb"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "fonts": {
                  "inline": false
                }
              }
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "template:build:production"
            },
            "development": {
              "buildTarget": "template:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "template:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": [],
            "include": [
              "src/app/core/guard/auth/auth.guard.spec.ts",
              "src/app/core/service/settings/settings.service.spec.ts",
              "src/app/core/service/spinner/spinner.service.spec.ts",
              "src/app/core/service/common/common.service.spec.ts",
              "src/app/core/interceptor/spinner/spinner.interceptor.spec.ts",
              "src/app/shared/custom-pagination/pagination.service.spec.ts",
              "src/app/shared/custom-pagination/custom-pagination.component.spec.ts",
              "src/app/shared/sweetalert/sweetalert.service.spec.ts",
              "src/app/core-component/stock/view-stock/view-stock.component.spec.ts",
              "src/app/core-component/stock/adjust-stock/adjust-stock.component.spec.ts",
              "src/app/core-component/stock/list-stock-movements/list-stock-movements.component.spec.ts",
              "src/app/core-component/stock/list-stock/list-stock.component.spec.ts",
              "src/app/core-component/stock/list-stock-dashboard/list-stock-dashboard.component.spec.ts",
              "src/app/core-component/facture/list-facture-de-vente/list-facture-de-vente.component.spec.ts",
              "src/app/core-component/facture/generate-pdf-facture-de-vente/generate-pdf-facture-de-vente.component.spec.ts",
              "src/app/core-component/facture/facture.component.spec.ts",
              "src/app/core-component/client/edit-client/edit-client.component.spec.ts",
              "src/app/core-component/client/client.component.spec.ts",
              "src/app/core-component/client/add-client/add-client.component.spec.ts",
              "src/app/common-component/loader/loader.component.spec.ts",
              "src/app/common-component/layout/layout.component.spec.ts"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "03557ea8-102b-4722-a238-e9a8f140bd16"
  }
}